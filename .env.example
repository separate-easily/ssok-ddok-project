# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 확인 가능한 값들입니다.
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env는 git에 커밋되지 않습니다).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI 챗봇은 Firebase Functions(httpsCallable)로 호출되므로 별도 URL 설정이 필요 없습니다.
# 로컬에서 Functions 에뮬레이터로 테스트하려면 아래 값을 true로 설정하세요.
VITE_USE_FUNCTIONS_EMULATOR=
