# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 확인 가능한 값들입니다.
# 실제 값을 채운 뒤 .env로 복사해서 사용하세요 (.env는 git에 커밋되지 않습니다).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tier3(웹 검색) 기능 on/off. 비워두거나 "false"가 아니면 기본적으로 켜짐.
VITE_ENABLE_WEB_SEARCH=

# /api/chat, /api/search 를 호출할 때 같이 보내는 값 (api/_shared.ts 참고).
# 진짜 비밀은 아님 — 브라우저 번들에 그대로 포함됨. 무작위 크롤러 차단용 최소 장치.
# Vercel 프로젝트 환경변수의 PROXY_ACCESS_TOKEN과 같은 값이어야 함.
VITE_PROXY_ACCESS_TOKEN=

# ------------------------------------------------------------------
# 아래 값들은 브라우저에 절대 노출되지 않습니다 (VITE_ 접두사 없음).
# 배포된 앱은 Vercel 프로젝트 환경변수(Settings > Environment Variables)로
# OPENAI_API_KEY / SEARCH_API_KEY / SEARCH_ENGINE_ID / PROXY_ACCESS_TOKEN을
# 등록해서 씁니다 (api/chat.ts, api/search.ts 참고).
# 여기 값은 오직 로컬에서 scripts/runEnhancedTestset.ts 같은
# Node 회귀 테스트 스크립트를 직접 돌릴 때만 사용됩니다.
# ------------------------------------------------------------------
OPENAI_API_KEY=
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
