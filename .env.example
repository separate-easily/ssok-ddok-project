# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 확인 가능한 값들입니다.
# 실제 값을 채운 뒤 .env로 복사해서 사용하세요 (.env는 git에 커밋되지 않습니다).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 아래 값은 VITE_ 접두사가 없어 브라우저 번들에 포함되지 않습니다.
# 로컬 개발 시 vite.config.ts가 .env에서 읽어 개발 서버 프로세스에 주입하고,
# 배포된 앱은 Vercel 프로젝트 환경변수(Settings > Environment Variables)로 등록해서 씁니다.
# (api/chat.ts, api/_lib/cors.ts 참고)
# ------------------------------------------------------------------

# OpenAI API 키 (필수) — /api/chat 프록시가 사용합니다.
OPENAI_API_KEY=

# CORS 허용 도메인 (선택, 쉼표 구분). 프런트와 API가 같은 도메인이면 비워둬도 됩니다.
# 예) https://내도메인.co.kr,http://localhost:5173
ALLOWED_ORIGINS=

# Tier3(웹 검색) 기능 on/off. 비워두거나 "false"가 아니면 기본적으로 켜짐.
VITE_ENABLE_WEB_SEARCH=

# Google Custom Search 키 (선택 — 미설정 시 모의 검색 결과로 동작).
# 이 값은 VITE_ 접두사가 붙어 브라우저 번들에 노출됩니다(의도된 설계).
# Google Cloud Console > 사용자 인증 정보 > 해당 키에서
# 애플리케이션 제한사항을 HTTP 리퍼러(배포 도메인 + http://localhost:5173)로,
# API 제한사항을 Custom Search API만 허용하도록 반드시 설정하세요.
VITE_SEARCH_API_KEY=
VITE_SEARCH_ENGINE_ID=

# scripts/runEnhancedTestset.ts 같은 Node 회귀 테스트 스크립트 전용.
# 스크립트는 상대 경로(/api/chat)를 쓸 수 없으므로 배포된 절대 주소를 넣어야 합니다.
# 예) VITE_CHAT_API_URL=https://ssok-ddok-api.vercel.app/api/chat
VITE_CHAT_API_URL=
